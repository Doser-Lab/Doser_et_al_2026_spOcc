# Comparison of spatial and nonspatial model results ----------------------
spatial_summary_df <- summary_df
# Loads an object called summary_df
load("results/nonspatial_summary_sim_1_results.rda")
spatial_summary_df$model <- "Spatial"
summary_df$model <- "Nonspatial"
full_summary_df <- rbind(spatial_summary_df, summary_df)
str(full_summary_df)
mean(full_summary_df$bias[full_summary_df$model == "Spatial"])
mean(full_summary_df$bias[full_summary_df$model == "Nonspatial"])
mean(full_summary_df$coverage[full_summary_df$model == "Nonspatial"])
mean(full_summary_df$coverage[full_summary_df$model == "Spatial"])
# Explore model results ---------------
full_summary_df %>%
group_by(model, n_plot, design) %>%
summarize(bias = mean(bias),
coverage = mean(coverage),
ci_width = mean(ci_width)) %>%
ungroup() %>%
arrange(n_plot, design, model) %>%
print(n = nrow(.))
# Explore model results ---------------
full_summary_df %>%
group_by(model, n_plot) %>%
summarize(bias = mean(bias),
coverage = mean(coverage),
ci_width = mean(ci_width)) %>%
ungroup() %>%
arrange(n_plot, design, model) %>%
print(n = nrow(.))
# Explore model results ---------------
full_summary_df %>%
group_by(model, n_plot) %>%
summarize(bias = mean(bias),
coverage = mean(coverage),
ci_width = mean(ci_width)) %>%
ungroup() %>%
arrange(n_plot, model) %>%
print(n = nrow(.))
# Explore model results ---------------
full_summary_df %>%
group_by(model, prevalence) %>%
summarize(bias = mean(bias),
coverage = mean(coverage),
ci_width = mean(ci_width)) %>%
ungroup() %>%
arrange(n_plot, model) %>%
print(n = nrow(.))
# Explore model results ---------------
full_summary_df %>%
group_by(model, prevalence) %>%
summarize(bias = mean(bias),
coverage = mean(coverage),
ci_width = mean(ci_width)) %>%
ungroup() %>%
arrange(n_plot, prevalence) %>%
print(n = nrow(.))
